{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_tasks_append_only.py\"",
            "timeout": 15,
            "statusMessage": "tasks/ の上書き保護を確認中"
          }
        ]
      }
    ]
  }
}
