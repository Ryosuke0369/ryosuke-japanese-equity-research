# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Temp files
*.tmp
~$*

# OS
.DS_Store
Thumbs.db

# EDINET downloads (large XBRL, re-fetchable via API)
edinet_data/
tmp/

# Editor
.vscode/
*.swp

# Environment
.env
.venv/
venv/

# Personal files (never commit by accident)
*.pdf
*.lnk
# Published research reports are the exception to the PDF rule
!reports/*.pdf
!models/reports/*.pdf

# Excel lock/owner files
~$*.xlsx
~$*.xls

# models/ は通常追跡。分析成果物(DCF/SOTP/market_analysis の xlsx・validation txt・
# レポートPDF)は DRAFT 含めて公開する方針。個人ファイル(CV等)は models/ に置かない。


# Screener data directory — blanket ignore, no exceptions.
#   raw/    TDnet 短信PDF + EDINET 生XBRL。短信は各社の著作物、J-Quants 規約は
#           取得データの再配布を禁止 → 公開リポジトリに置けない。
#   cache/  J-Quants の refreshToken / idToken キャッシュ(認証情報そのもの)。
#   logs/   実行ログ(取得先URL・件数などの運用痕跡)。
#   *.db    スクリーナーDB(上記 raw の派生物なので同じ制約がかかる)。
# screener/ 配下の設定・スキーマ・コードは data/ の外にあるので従来どおり追跡される。
screener/data/


# Databases anywhere in the tree (screener DB, ad-hoc SQLite scratch DBs).
# These are derivatives of TDnet/EDINET raw data — same redistribution limits.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Env files of every flavour (.env itself is listed above; these are the variants).
.env.*
!.env.example

# --- 別枠 earnings_screener (Kimi 由来の参照実装) -------------------------
# 統合引継ぎ書 v1.1 §1「モックのバックテスト数値は移植しない・git管理外推奨」。
# data/ は (1) 相関を人工注入したモック世界の数値であり実績と誤読される、
# (2) 生成スクリプトから再現できる、の2点で追跡しない。
# コード・PROVENANCE.md・tests/ は追跡する。
Kimi_Agent_Bモジュール進行/**/data/

# 配布パッケージ（batch/build_package.py が生成。成果物からいつでも再生成できる）
dist/
