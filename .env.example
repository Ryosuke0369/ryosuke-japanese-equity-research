# .env.example — コピーして .env を作る。.env 自体は git-ignored。
#   cp .env.example .env

# --- データ保存先 -------------------------------------------------------
# screener が書き込む一切合切 (raw/ cache/ logs/ screener.db) のルート。
# 未設定なら従来どおり screener/data/ 。別ドライブへ逃がしたいときだけ設定する。
# Windows はバックスラッシュのままでよい (クォート不要)。
DATA_ROOT=D:\screener_data
# 一時的に別の場所を指したいときだけ。DATA_ROOT より優先される。
#SCREENER_DATA_ROOT=
# DB だけを別ファイルにしたいとき (テスト用)。通常は空。
#SCREENER_DB=

# --- 認証情報 -----------------------------------------------------------
EDINET_API_KEY=
# J-Quants API V2。ダッシュボード (https://jpx-jquants.com/ja/dashboard) で
# 発行した API キーをそのまま置く。失効しないので更新運用は不要。
# V1 の JQUANTS_MAIL / JQUANTS_PASSWORD / JQUANTS_REFRESH_TOKEN は
# 2026-06-01 の V1 終了で廃止された。
JQUANTS_API_KEY=
